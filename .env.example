# Copy to .env and adjust. Loaded by science-graphrag via pydantic-settings.
# Secrets belong in .env only (gitignored).
#
# Naming: canonical variables use the SCIENCE_GRAPHRAG_ prefix (see Settings in
# science_graphrag/config.py). Unprefixed MAIN_LLM_* / OPENROUTER_API_KEY / API_KEY /
# BASE_URL are legacy osint-gr aliases; resolution order is centralized in
# science_graphrag/env_aliases.py.

# PDF bytes on disk (ingest + API download-by-sha). Default tree is ./data/blobs.
# If some shards are root-owned, rsync into ./data/blobs_merged and point this (and API/worker)
# at that path, or export SCIENCE_GRAPHRAG_BLOB_ROOT for a one-off CLI run (shell wins over .env).
# See docs/runbooks/ingest-corpus.md (PermissionError / blobs_merged).
SCIENCE_GRAPHRAG_BLOB_ROOT=./data/blobs
# docker-compose.dev.yml mounts this host path into api/worker at /data/blobs (same as SCIENCE_GRAPHRAG_BLOB_ROOT inside container).
# After rsync merge for pilot ingest, set to ./data/blobs_merged so API serves the same bytes as CLI ingest.
# SCIENCE_GRAPHRAG_HOST_BLOB_MOUNT=./data/blobs_merged
SCIENCE_GRAPHRAG_ARTIFACT_ROOT=./data/artifacts
SCIENCE_GRAPHRAG_DATABASE_URL=postgresql+psycopg://science:science@localhost:15432/science_graphrag
# Compose-internal DB URL used by docker compose files (service-to-service, no localhost).
# Keep password in your private .env, never commit real secrets.
# SCIENCE_GRAPHRAG_DATABASE_URL_DOCKER=postgresql+psycopg://science:change-me@postgres:5432/science_graphrag
SCIENCE_GRAPHRAG_NEO4J_URI=bolt://localhost:17687
SCIENCE_GRAPHRAG_NEO4J_USER=neo4j
SCIENCE_GRAPHRAG_NEO4J_PASSWORD=sciencegraphrag
SCIENCE_GRAPHRAG_QDRANT_URL=http://localhost:16333
SCIENCE_GRAPHRAG_REDIS_URL=redis://localhost:16379/0
SCIENCE_GRAPHRAG_QDRANT_COLLECTION=chunks
# Wave L: one vector per Work (title+abstract+first author) for smart dedup
# SCIENCE_GRAPHRAG_QDRANT_WORK_EMBEDDINGS_COLLECTION=work_embeddings
# SCIENCE_GRAPHRAG_QDRANT_AUTHOR_EMBEDDINGS_COLLECTION=author_embeddings
# Optional: Neo4j GDS plugin for large workspace multi-hop graphs (API still falls back to Cypher).
# SCIENCE_GRAPHRAG_GDS_ENABLED=false
# When using ``docker compose -f docker-compose.dev.yml``, the ``api`` service sets
# ``SCIENCE_GRAPHRAG_SKIP_HOST_DOTENV=1`` so Compose Neo4j/Qdrant/Postgres URLs are not
# overwritten by the host-oriented ``localhost`` lines above. Do not remove that from compose.
SCIENCE_GRAPHRAG_OPENALEX_MAILTO=you@example.com
# SCIENCE_GRAPHRAG_ROR_LOOKUP_ENABLED=false
SCIENCE_GRAPHRAG_USE_VL_FOR_PDF=true
# Max size (MB) per workspace PDF/MD/TXT upload; also configurable in Settings → Ingestion.
# Reverse proxy (nginx client_max_body_size) must be >= this value.
# SCIENCE_GRAPHRAG_WORKSPACE_UPLOAD_MAX_FILE_SIZE_MB=128

# Logging: DEBUG, INFO, WARNING, ERROR
# SCIENCE_GRAPHRAG_LOG_LEVEL=INFO

# VL / OpenRouter (prefixed — highest priority for pdf -> markdown)
# SCIENCE_GRAPHRAG_VL_API_KEY=your-openrouter-api-key
# SCIENCE_GRAPHRAG_VL_BASE_URL=https://openrouter.ai/api/v1
# SCIENCE_GRAPHRAG_VL_MODEL=qwen/qwen3-vl-235b-a22b-instruct
# SCIENCE_GRAPHRAG_REUSE_CACHED_MARKDOWN=true

# Stage extraction LLM (markdown -> WorkDraft / authors / references), OpenAI-compatible API.
# Defaults to true; set false to use heuristic regex stages only.
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_ENABLED=true
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_API_KEY=
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_BASE_URL=https://openrouter.ai/api/v1
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_MODEL=mistralai/mistral-small-3.2-24b-instruct
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_TEMPERATURE=0.0
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_MAX_TOKENS_METADATA=4096
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_MAX_TOKENS_REFERENCES=8192
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_TIMEOUT_SECONDS=180
# Instructor mode override: auto, tools, json, md_json, openrouter_structured_outputs
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_MODE=auto
# References: batch size, conservative merge vs union, max extra rows beyond heuristic, parallel chunks
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_REFERENCES_BATCH_SIZE=12
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_REFERENCES_MERGE_POLICY=conservative
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_REFERENCES_MERGE_MAX_EXTRA=2
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_REFERENCES_MAX_CONCURRENCY=1
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_REFERENCE_TITLES_ENABLED=true

# Claims / epistemic layer (Wave O; requires extraction LLM credentials)
# Defaults to true; also configurable in Settings → Ingestion.
# SCIENCE_GRAPHRAG_CLAIMS_EXTRACTION_ENABLED=true
# SCIENCE_GRAPHRAG_CLAIMS_EXTRACTION_MAX_TOKENS=4096
# SCIENCE_GRAPHRAG_QDRANT_CLAIMS_COLLECTION=claims

# Document slices & section-aware retrieval chunks
# SCIENCE_GRAPHRAG_FRONT_MATTER_MAX_CHARS=12000
# SCIENCE_GRAPHRAG_REFERENCES_SCOPE_MAX_CHARS=90000
# SCIENCE_GRAPHRAG_CHUNK_TARGET_TOKENS=1200
# SCIENCE_GRAPHRAG_CHUNK_OVERLAP_TOKENS=140
# Chunk boundary engine: chonkie_recursive (default) or legacy (requires chonkie+jsonschema in deps)
# SCIENCE_GRAPHRAG_CHUNKING_ENGINE=chonkie_recursive
# SCIENCE_GRAPHRAG_CHUNKING_CHONKIE_RECIPE=markdown
# SCIENCE_GRAPHRAG_CHUNKING_CHONKIE_LANG=en
# SCIENCE_GRAPHRAG_CHUNKING_CHONKIE_MIN_CHARACTERS_PER_CHUNK=24

# --- Legacy osint-gr-compatible aliases (used when prefixed SCIENCE_GRAPHRAG_* are unset) ---
# API key order for merge: MAIN_LLM_API_KEY -> OPENROUTER_API_KEY -> API_KEY
# MAIN_LLM_API_KEY=
# OPENROUTER_API_KEY=
# MAIN_LLM_BASE_URL=https://openrouter.ai/api/v1
# BASE_URL=
# MAIN_LLM_MODEL=mistralai/mistral-small-3.2-24b-instruct
# USE_VL_FOR_PDF=true
# API_KEY=

# Phoenix (no SCIENCE_GRAPHRAG_ prefix — same as osint-gr)
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# Один стабильный проект в UI Phoenix; не переопределяйте PHOENIX_PROJECT_NAME в shell для отладки — иначе появятся отдельные «проекты».
# PHOENIX_PROJECT_NAME=science-graphrag
# Phoenix 13.x: REST ``/v1/projects/{id}/…`` + UI ``/projects/{id}/traces/{traceId}`` (eval --fetch-phoenix, roadmap trace_audit).
# Optional override when UI slug / GlobalID differs from PHOENIX_PROJECT_NAME:
# PHOENIX_PROJECT_ID=
# Base URL of Phoenix web (not the OTLP collector path). Used by chat-agent roadmap --fetch-phoenix and deep links.
# PHOENIX_UI_BASE_URL=http://127.0.0.1:6006
# PHOENIX_API_KEY=
# PHOENIX_OPENAI_AUTO_INSTRUMENTATION=1
# Трассировка: full (по умолчанию) или extraction_llm — только layer-1 LLM извлечение + ingest/metadata CHAIN
# PHOENIX_TRACE_SCOPE=extraction_llm

# Optional: sentence-transformers (local torch). If unset, deterministic hash vectors (CI/smoke).
# SCIENCE_GRAPHRAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
#
# OpenRouter / OpenAI-compatible embeddings (POST /v1/embeddings). Uses MAIN_LLM_API_KEY /
# MAIN_LLM_BASE_URL (or SCIENCE_GRAPHRAG_EXTRACTION_LLM_* / BENCHMARK_TEACHER_*) when set.
# When set, overrides sentence-transformers for ingestion, retrieval, and dedup.
# Full cutover (drop Qdrant collections, reingest, rerun BT1–BT5): docs/adr/021-openrouter-bge-m3-embeddings.md
# SCIENCE_GRAPHRAG_OPENROUTER_EMBEDDING_MODEL=baai/bge-m3
# SCIENCE_GRAPHRAG_OPENROUTER_EMBEDDING_DIM=1024
# SCIENCE_GRAPHRAG_OPENROUTER_EMBEDDING_CACHE_ROOT=./data/embeddings_cache
# EMBEDDING_MODEL=baai/bge-m3   # used by eval/dual_validate only (see openrouter_provider)

# Optional: second-stage LLM for POST /v1/query (paraphrase grounded on retrieved citation excerpts).
# Reuses extraction LLM URL/model/api key when those are configured.
# SCIENCE_GRAPHRAG_QUERY_ANSWER_LLM_ENABLED=false
# SCIENCE_GRAPHRAG_QUERY_ANSWER_LLM_MAX_TOKENS=900
# SCIENCE_GRAPHRAG_QUERY_ANSWER_LLM_TEMPERATURE=0.0

# LangGraph / LangChain (Wave Y1)
# SCIENCE_GRAPHRAG_LANGCHAIN_TRACING_V2=false
# SCIENCE_GRAPHRAG_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# SCIENCE_GRAPHRAG_AGENT_RUNTIME=retrieval_v1   # retrieval_v1 | langgraph_v2 (Wave Y2+)
# SCIENCE_GRAPHRAG_AGENT_MAX_TOOL_CALLS=8
# Wall-clock seconds for one full LangGraph turn (sync invoke or SSE stream collection).
# SCIENCE_GRAPHRAG_AGENT_STEP_TIMEOUT_SECONDS=120
# SCIENCE_GRAPHRAG_AGENT_RULE_TOOL_SEARCH_ENABLED=true   # Wave A CH3: rule-based tool shortlist
# Coordinator turn policy: rules_v0 (default) | hybrid_v1 | llm_v1 (structured LLM + confidence)
# SCIENCE_GRAPHRAG_AGENT_TURN_POLICY_CLASSIFIER=rules_v0
# SCIENCE_GRAPHRAG_AGENT_TURN_POLICY_LLM_ENABLED=false
# SCIENCE_GRAPHRAG_AGENT_TURN_POLICY_CONFIDENCE_THRESHOLD=0.65
# SCIENCE_GRAPHRAG_AGENT_TURN_POLICY_CLASSIFIER_TIMEOUT_SECONDS=25
# CH4 session memory: process-local (memory) or shared Redis (redis; survives API worker restarts)
# SCIENCE_GRAPHRAG_AGENT_SESSION_MEMORY_BACKEND=memory
# SCIENCE_GRAPHRAG_AGENT_SESSION_REDIS_KEY_PREFIX=science_graphrag:agent_session:v1
# SCIENCE_GRAPHRAG_AGENT_SESSION_REDIS_TTL_SECONDS=604800
# CH5 compaction thresholds (digest cap matches in-store window of 10)
# SCIENCE_GRAPHRAG_AGENT_COMPACTION_ROLLING_MEMORY_MIN_DIGESTS=3
# SCIENCE_GRAPHRAG_AGENT_COMPACTION_DIGEST_CAP=10

# Optional: require X-Admin-Key header for /v1/benchmark/* and /v1/settings/* (shared secret).
# SCIENCE_GRAPHRAG_ADMIN_API_KEY=

# --- Vite UI (`ui/`) — use `ui/.env.local` (not loaded by pydantic) ---
# VITE_API_BASE_URL=http://127.0.0.1:8787
# Wave O: collapsible Claims panel in workspace Reader tab (ReaderClaimsPanel).
# VITE_CLAIMS_UI_ENABLED=1
# Optional: default-on server sync for Ask (otherwise toggle persists in localStorage).
# VITE_SYNC_ASK_SESSIONS=true
