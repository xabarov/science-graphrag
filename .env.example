# Copy to .env and adjust. Loaded by science-graphrag via pydantic-settings.
# Secrets belong in .env only (gitignored).

SCIENCE_GRAPHRAG_BLOB_ROOT=./data/blobs
SCIENCE_GRAPHRAG_ARTIFACT_ROOT=./data/artifacts
SCIENCE_GRAPHRAG_DATABASE_URL=postgresql+psycopg://science:science@localhost:15432/science_graphrag
SCIENCE_GRAPHRAG_NEO4J_URI=bolt://localhost:17687
SCIENCE_GRAPHRAG_NEO4J_USER=neo4j
SCIENCE_GRAPHRAG_NEO4J_PASSWORD=sciencegraphrag
SCIENCE_GRAPHRAG_QDRANT_URL=http://localhost:16333
SCIENCE_GRAPHRAG_QDRANT_COLLECTION=chunks
SCIENCE_GRAPHRAG_OPENALEX_MAILTO=you@example.com
# SCIENCE_GRAPHRAG_ROR_LOOKUP_ENABLED=false
SCIENCE_GRAPHRAG_USE_VL_FOR_PDF=true

# Logging: DEBUG, INFO, WARNING, ERROR
# SCIENCE_GRAPHRAG_LOG_LEVEL=INFO

# VL / OpenRouter (prefixed — highest priority for pdf -> markdown)
# SCIENCE_GRAPHRAG_VL_API_KEY=your-openrouter-api-key
# SCIENCE_GRAPHRAG_VL_BASE_URL=https://openrouter.ai/api/v1
# SCIENCE_GRAPHRAG_VL_MODEL=qwen/qwen3-vl-235b-a22b-instruct
# SCIENCE_GRAPHRAG_REUSE_CACHED_MARKDOWN=true

# Stage extraction LLM (markdown -> WorkDraft / authors / references), OpenAI-compatible API.
# Defaults to true; set false to use heuristic regex stages only.
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_ENABLED=true
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_API_KEY=
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_BASE_URL=https://openrouter.ai/api/v1
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_MODEL=mistralai/mistral-small-3.2-24b-instruct
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_TEMPERATURE=0.0
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_MAX_TOKENS_METADATA=4096
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_MAX_TOKENS_REFERENCES=8192
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_TIMEOUT_SECONDS=180

# Document slices & section-aware retrieval chunks
# SCIENCE_GRAPHRAG_FRONT_MATTER_MAX_CHARS=12000
# SCIENCE_GRAPHRAG_REFERENCES_SCOPE_MAX_CHARS=90000
# SCIENCE_GRAPHRAG_CHUNK_TARGET_TOKENS=1200
# SCIENCE_GRAPHRAG_CHUNK_OVERLAP_TOKENS=140

# osint-gr-compatible aliases (used when SCIENCE_GRAPHRAG_* / USE_VL are not set)
# MAIN_LLM_API_KEY=
# MAIN_LLM_BASE_URL=https://openrouter.ai/api/v1
# MAIN_LLM_MODEL=mistralai/mistral-small-3.2-24b-instruct
# USE_VL_FOR_PDF=true
# API_KEY=
# BASE_URL=

# Phoenix (no SCIENCE_GRAPHRAG_ prefix — same as osint-gr)
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_PROJECT_NAME=science-graphrag
# PHOENIX_API_KEY=
# PHOENIX_OPENAI_AUTO_INSTRUMENTATION=1

# Optional: real embeddings (otherwise deterministic hash vectors)
# SCIENCE_GRAPHRAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
