# Copy to .env and adjust. Loaded by science-graphrag via pydantic-settings.
# Secrets belong in .env only (gitignored).
#
# Quick setup for most users:
# 1. Copy this file to `.env`.
# 2. Set SCIENCE_GRAPHRAG_S3_* below (or rely on compose overrides for api/worker only). Host CLI/pytest needs
#    non-empty SCIENCE_GRAPHRAG_S3_ACCESS_KEY_ID and SCIENCE_GRAPHRAG_S3_SECRET_ACCESS_KEY in `.env` or the shell.
# 3. Set SCIENCE_GRAPHRAG_OPENALEX_MAILTO to your email (not a secret; used for OpenAlex enrichment),
#    or set the same value in the UI under Settings → General (saved to data/settings/runtime_settings.json).
# 4. Set SCIENCE_GRAPHRAG_API_KEY for OpenRouter-compatible extraction, embeddings, and VL PDF→Markdown.
# 5. Keep Postgres / Neo4j / Qdrant / Redis defaults below if you use local docker compose as documented.
# 6. Run `.venv/bin/science-graphrag config-check` (S3 preflight is on by default; use `--no-strict` only if you omit extraction LLM key on purpose).
#
# Important:
# - S3-compatible storage (MinIO or AWS) is mandatory: without SCIENCE_GRAPHRAG_S3_ACCESS_KEY_ID /
#   SCIENCE_GRAPHRAG_S3_SECRET_ACCESS_KEY / SCIENCE_GRAPHRAG_S3_BUCKET, Settings() fails on the host.
# - Without SCIENCE_GRAPHRAG_API_KEY the stack may still start once S3 is set, but extraction and PDF→Markdown are limited.
# - UI variables live in `ui/.env.local`, not here.
#
# Naming: use the SCIENCE_GRAPHRAG_ prefix for all application settings (see Settings in
# science_graphrag/config.py).

# PDF bytes on disk (ingest + API download-by-sha). Default tree is ./data/blobs.
# If some shards are root-owned, rsync into ./data/blobs_merged and point this (and API/worker)
# at that path, or export SCIENCE_GRAPHRAG_BLOB_ROOT for a one-off CLI run (shell wins over .env).
# See docs/runbooks/ingest-corpus.md (PermissionError / blobs_merged).
SCIENCE_GRAPHRAG_BLOB_ROOT=./data/blobs
# S3/MinIO (mandatory): ingest queue, raw blobs, ingest artifacts, UI benchmark full JSON, diagnostics.
# docker compose maps MinIO to localhost:19000; default credentials match the compose minio service.
# Migrate existing disk: docs/runbooks/mandatory-s3-migration.md (artifacts → raw blobs → benchmark runs).
SCIENCE_GRAPHRAG_S3_ENDPOINT_URL=http://localhost:19000
SCIENCE_GRAPHRAG_S3_ACCESS_KEY_ID=minioadmin
SCIENCE_GRAPHRAG_S3_SECRET_ACCESS_KEY=minioadmin
SCIENCE_GRAPHRAG_S3_BUCKET=science-raw
SCIENCE_GRAPHRAG_S3_USE_SSL=false
SCIENCE_GRAPHRAG_S3_ADDRESSING_STYLE=path
# SCIENCE_GRAPHRAG_S3_ARTIFACT_KEY_PREFIX=science-artifacts
# SCIENCE_GRAPHRAG_S3_BENCHMARK_RUNS_KEY_PREFIX=science-benchmarks
# SCIENCE_GRAPHRAG_S3_DIAGNOSTICS_KEY_PREFIX=science-diagnostics
# Phase 4: retention hints (object tags / metadata) for GC and ops; 0 = omit hint from uploads.
# SCIENCE_GRAPHRAG_OBJECT_STORAGE_DIAGNOSTICS_RETENTION_DAYS=30
# SCIENCE_GRAPHRAG_OBJECT_STORAGE_BENCHMARK_FULL_RETENTION_DAYS=90
# Lifecycle examples: docs/runbooks/minio-object-lifecycle-phase4.md
# Optional: run live MinIO probe test (requires reachable S3/MinIO):
# SCIENCE_GRAPHRAG_MINIO_E2E=1
# .venv/bin/pytest tests/integration/test_minio_object_storage_e2e.py -q
# One-shot migration of existing local full run JSON: ``.venv/bin/python scripts/sync_benchmark_runs_to_s3.py``
# docker-compose.yml / docker-compose.dev.yml set SCIENCE_GRAPHRAG_S3_ENDPOINT_URL=http://minio:9000 and map
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD into SCIENCE_GRAPHRAG_S3_ACCESS_KEY_ID / _SECRET_ACCESS_KEY for api/worker.
# docker-compose.dev.yml mounts this host path into api/worker at /data/blobs (same as SCIENCE_GRAPHRAG_BLOB_ROOT inside container).
# After rsync merge for pilot ingest, set to ./data/blobs_merged so API serves the same bytes as CLI ingest.
# SCIENCE_GRAPHRAG_HOST_BLOB_MOUNT=./data/blobs_merged
# --- Core local paths and services (most users can keep these defaults) ---
SCIENCE_GRAPHRAG_ARTIFACT_ROOT=./data/artifacts
SCIENCE_GRAPHRAG_DATABASE_URL=postgresql+psycopg://science:science@localhost:15432/science_graphrag
# Compose-internal DB URL used by docker compose files (service-to-service, no localhost).
# Keep password in your private .env, never commit real secrets.
# SCIENCE_GRAPHRAG_DATABASE_URL_DOCKER=postgresql+psycopg://science:change-me@postgres:5432/science_graphrag
SCIENCE_GRAPHRAG_NEO4J_URI=bolt://localhost:17687
SCIENCE_GRAPHRAG_NEO4J_USER=neo4j
SCIENCE_GRAPHRAG_NEO4J_PASSWORD=sciencegraphrag
SCIENCE_GRAPHRAG_QDRANT_URL=http://localhost:16333
SCIENCE_GRAPHRAG_REDIS_URL=redis://localhost:16379/0
SCIENCE_GRAPHRAG_QDRANT_COLLECTION=chunks
# Wave L: one vector per Work (title+abstract+first author) for smart dedup
# SCIENCE_GRAPHRAG_QDRANT_WORK_EMBEDDINGS_COLLECTION=work_embeddings
# SCIENCE_GRAPHRAG_QDRANT_AUTHOR_EMBEDDINGS_COLLECTION=author_embeddings
# Optional: Neo4j GDS plugin for large workspace multi-hop graphs (API still falls back to Cypher).
# SCIENCE_GRAPHRAG_GDS_ENABLED=false
# When using ``docker compose -f docker-compose.dev.yml``, the ``api`` service sets
# ``SCIENCE_GRAPHRAG_SKIP_HOST_DOTENV=1`` so Compose Neo4j/Qdrant/Postgres URLs are not
# overwritten by the host-oriented ``localhost`` lines above. Do not remove that from compose.
# Required for normal metadata enrichment via OpenAlex. Not a secret.
SCIENCE_GRAPHRAG_OPENALEX_MAILTO=you@example.com
# SCIENCE_GRAPHRAG_ROR_LOOKUP_ENABLED=false
# Keep `true` if you want PDF -> Markdown via VL model before fallback to pypdf.
SCIENCE_GRAPHRAG_USE_VL_FOR_PDF=true
# Max size (MB) per workspace PDF/MD/TXT upload; also configurable in Settings → Ingestion.
# Reverse proxy (nginx client_max_body_size) must be >= this value.
# SCIENCE_GRAPHRAG_WORKSPACE_UPLOAD_MAX_FILE_SIZE_MB=128

# Logging: DEBUG, INFO, WARNING, ERROR
# SCIENCE_GRAPHRAG_LOG_LEVEL=INFO
# Optional: DEBUG only for science_graphrag.ingestion subtree (unset = inherit LOG_LEVEL).
# SCIENCE_GRAPHRAG_LOG_LEVEL_INGEST=
# SCIENCE_GRAPHRAG_HTTP_LOG_LEVEL=WARNING
# SCIENCE_GRAPHRAG_DRAMATIQ_LOG_LEVEL=WARNING
# SCIENCE_GRAPHRAG_DRAMATIQ_PROCESSES=1
# SCIENCE_GRAPHRAG_DRAMATIQ_THREADS=8
# SCIENCE_GRAPHRAG_INGEST_VL_LOG_HEARTBEAT_SECONDS=60
# SCIENCE_GRAPHRAG_INGEST_PIPELINE_LOG_HEARTBEAT_SECONDS=60
# SCIENCE_GRAPHRAG_LOG_FORMAT=text
# SCIENCE_GRAPHRAG_METRICS_ENABLED=false
# PHOENIX_OTEL_VERBOSE=0

# --- Most important API credentials for a useful setup ---
#
# Canonical unified key (OpenRouter / OpenAI-compatible) for extraction + VL (when VL key unset) + OpenRouter embeddings.
# SCIENCE_GRAPHRAG_API_KEY=your-openrouter-api-key
#
# VL / OpenRouter (used for PDF -> Markdown; usually the first key you want working)
# SCIENCE_GRAPHRAG_VL_API_KEY=your-openrouter-api-key
# SCIENCE_GRAPHRAG_VL_BASE_URL=https://openrouter.ai/api/v1
# SCIENCE_GRAPHRAG_VL_MODEL=qwen/qwen3-vl-235b-a22b-instruct
# SCIENCE_GRAPHRAG_REUSE_CACHED_MARKDOWN=true

# Stage extraction LLM (markdown -> WorkDraft / authors / references), OpenAI-compatible API.
# This is the other key most users need for meaningful extraction quality.
# Defaults to true; set false to use heuristic regex stages only.
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_ENABLED=true
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_API_KEY=
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_BASE_URL=https://openrouter.ai/api/v1
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_MODEL=mistralai/mistral-small-3.2-24b-instruct
# Optional: research chat (POST /v2/agent/query) uses this model when set; otherwise extraction model.
# Example live eval: SCIENCE_GRAPHRAG_CHAT_LLM_MODEL=qwen/qwen3-235b-a22b-2507
# SCIENCE_GRAPHRAG_CHAT_LLM_MODEL=
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_TEMPERATURE=0.0
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_MAX_TOKENS_METADATA=4096
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_MAX_TOKENS_REFERENCES=8192
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_TIMEOUT_SECONDS=180
# Instructor mode override: auto, tools, json, md_json, openrouter_structured_outputs
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_MODE=auto
# References: batch size, conservative merge vs union, max extra rows beyond heuristic, parallel chunks
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_REFERENCES_BATCH_SIZE=12
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_REFERENCES_MERGE_POLICY=conservative
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_REFERENCES_MERGE_MAX_EXTRA=2
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_REFERENCES_MAX_CONCURRENCY=1
# SCIENCE_GRAPHRAG_EXTRACTION_LLM_REFERENCE_TITLES_ENABLED=true
#
# Phase 2 — per-process LLM concurrency pools (threading + translation SSE asyncio cap).
# See science_graphrag/llm/concurrency.py; legacy references cap stays synced with
# SCIENCE_GRAPHRAG_LLM_CONCURRENCY_EXTRACTION_REFERENCES when only one is set.
# SCIENCE_GRAPHRAG_LLM_CONCURRENCY_DEFAULT=4
# SCIENCE_GRAPHRAG_LLM_CONCURRENCY_TRANSLATION=2
# SCIENCE_GRAPHRAG_LLM_CONCURRENCY_EXTRACTION_REFERENCES=1
# SCIENCE_GRAPHRAG_LLM_CONCURRENCY_CLAIMS=2
# SCIENCE_GRAPHRAG_LLM_CONCURRENCY_SUMMARY=2
# SCIENCE_GRAPHRAG_LLM_CONCURRENCY_SEMANTIC=4
# SCIENCE_GRAPHRAG_LLM_CONCURRENCY_DEDUP=4
# SCIENCE_GRAPHRAG_LLM_CONCURRENCY_AGENT_CHAT=8
# SCIENCE_GRAPHRAG_LLM_CONCURRENCY_AGENT_CLASSIFIER=8
# SCIENCE_GRAPHRAG_LLM_CONCURRENCY_QUERY_ANSWER=6

# --- Advanced / feature-specific settings below this point ---
#
# Claims / epistemic layer (Wave O; requires extraction LLM credentials)
# Defaults to true; also configurable in Settings → Ingestion.
# SCIENCE_GRAPHRAG_CLAIMS_EXTRACTION_ENABLED=true
# SCIENCE_GRAPHRAG_CLAIMS_EXTRACTION_MAX_TOKENS=4096
# SCIENCE_GRAPHRAG_QDRANT_CLAIMS_COLLECTION=claims

# Document slices & section-aware retrieval chunks
# SCIENCE_GRAPHRAG_FRONT_MATTER_MAX_CHARS=12000
# SCIENCE_GRAPHRAG_REFERENCES_SCOPE_MAX_CHARS=90000
# SCIENCE_GRAPHRAG_CHUNK_TARGET_TOKENS=1200
# SCIENCE_GRAPHRAG_CHUNK_OVERLAP_TOKENS=140
# Chunk boundary engine: chonkie_recursive (default) or legacy (requires chonkie+jsonschema in deps)
# SCIENCE_GRAPHRAG_CHUNKING_ENGINE=chonkie_recursive
# SCIENCE_GRAPHRAG_CHUNKING_CHONKIE_RECIPE=markdown
# SCIENCE_GRAPHRAG_CHUNKING_CHONKIE_LANG=en
# SCIENCE_GRAPHRAG_CHUNKING_CHONKIE_MIN_CHARACTERS_PER_CHUNK=24

# Phoenix (no SCIENCE_GRAPHRAG_ prefix — same as osint-gr)
# OTLP HTTP ingest from the HOST (CLI, pytest, benchmarks on your machine): compose maps container :6006 → host :16006
# PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:16006/v1/traces
# Inside Docker network (api container → phoenix service): http://phoenix:6006/v1/traces — see docker-compose.yml
# Один стабильный проект в UI Phoenix; не переопределяйте PHOENIX_PROJECT_NAME в shell для отладки — иначе появятся отдельные «проекты».
# PHOENIX_PROJECT_NAME=science-graphrag
# Phoenix 13.x: REST ``/v1/projects/{id}/…`` + UI ``/projects/{id}/traces/{traceId}`` (eval --fetch-phoenix, roadmap trace_audit).
# Optional override when UI slug / GlobalID differs from PHOENIX_PROJECT_NAME:
# PHOENIX_PROJECT_ID=
# Base URL of Phoenix web (not the OTLP collector path). Used by chat-agent roadmap --fetch-phoenix and deep links.
# PHOENIX_UI_BASE_URL=http://127.0.0.1:16006
# PHOENIX_API_KEY=
# PHOENIX_OPENAI_AUTO_INSTRUMENTATION=1
# Трассировка: full (по умолчанию) или extraction_llm — ingest allowlist + agent-префиксы
# (chain ``agent.*``, LLM ``llm.agent.*``, retriever ``retrieval.qdrant.*``) чтобы ``phoenix_trace_id`` в чате не терялся.
# PHOENIX_TRACE_SCOPE=extraction_llm

# Optional: sentence-transformers (local torch). If unset, deterministic hash vectors (CI/smoke).
# SCIENCE_GRAPHRAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
#
# OpenRouter / OpenAI-compatible embeddings (POST /v1/embeddings). Uses the same credentials
# as extraction LLM (SCIENCE_GRAPHRAG_EXTRACTION_LLM_* or BENCHMARK_TEACHER_*).
# When set, overrides sentence-transformers for ingestion, retrieval, and dedup.
# Full cutover (drop Qdrant collections, reingest, rerun BT1–BT5): docs/adr/021-openrouter-bge-m3-embeddings.md
# SCIENCE_GRAPHRAG_OPENROUTER_EMBEDDING_MODEL=baai/bge-m3
# SCIENCE_GRAPHRAG_OPENROUTER_EMBEDDING_DIM=1024
# SCIENCE_GRAPHRAG_OPENROUTER_EMBEDDING_CACHE_ROOT=./data/embeddings_cache
# Optional: second-stage LLM for POST /v1/query (paraphrase grounded on retrieved citation excerpts).
# Reuses extraction LLM URL/model/api key when those are configured.
# SCIENCE_GRAPHRAG_QUERY_ANSWER_LLM_ENABLED=false
# SCIENCE_GRAPHRAG_QUERY_ANSWER_LLM_MAX_TOKENS=900
# SCIENCE_GRAPHRAG_QUERY_ANSWER_LLM_TEMPERATURE=0.0

# LangGraph / LangChain (Wave Y1)
# SCIENCE_GRAPHRAG_LANGCHAIN_TRACING_V2=false
# SCIENCE_GRAPHRAG_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default dev/prod runtime is the multi-agent supervisor (ADR-029, 2026-05-08).
# Use ``langgraph_research_v1`` only for explicit ReAct comparison runs / regression baselines.
# SCIENCE_GRAPHRAG_AGENT_RUNTIME=langgraph_supervisor_v3   # langgraph_supervisor_v3 | langgraph_research_v1 | retrieval_v1
# SCIENCE_GRAPHRAG_AGENT_MAX_TOOL_CALLS=8
# Wall-clock seconds for one full LangGraph turn (sync invoke or SSE stream collection).
# SCIENCE_GRAPHRAG_AGENT_STEP_TIMEOUT_SECONDS=120
# Phase 4 — agent timeout containment: LangChain HTTP retries, graph invoke thread pool, hop reserve
# SCIENCE_GRAPHRAG_AGENT_CHAT_MAX_RETRIES=1
# SCIENCE_GRAPHRAG_AGENT_CLASSIFIER_MAX_RETRIES=0
# SCIENCE_GRAPHRAG_AGENT_GRAPH_INVOKE_MAX_WORKERS=0
# SCIENCE_GRAPHRAG_AGENT_MIN_LLM_HOP_RESERVE_SECONDS=9
# SCIENCE_GRAPHRAG_AGENT_RULE_TOOL_SEARCH_ENABLED=true   # Wave A CH3: rule-based tool shortlist
# Score band for shortlist: threshold = top_score - band (default 1.35; use 1.5 for legacy-style A/B)
# SCIENCE_GRAPHRAG_AGENT_TOOL_SEARCH_SCORE_BAND=1.35
# Optional: truncate older ToolMessage bodies in single-agent ReAct (default off)
# SCIENCE_GRAPHRAG_AGENT_TOOL_HISTORY_COMPACT_ENABLED=false
# SCIENCE_GRAPHRAG_AGENT_TOOL_HISTORY_COMPACT_KEEP_LATEST_TOOL_MESSAGES=4
# SCIENCE_GRAPHRAG_AGENT_TOOL_HISTORY_COMPACT_MAX_TOOL_CHARS=6000
# Coordinator turn policy: rules_v0 (default) | hybrid_v1 | llm_v1 (structured LLM + confidence)
# SCIENCE_GRAPHRAG_AGENT_TURN_POLICY_CLASSIFIER=rules_v0
# SCIENCE_GRAPHRAG_AGENT_TURN_POLICY_LLM_ENABLED=false
# SCIENCE_GRAPHRAG_AGENT_TURN_POLICY_CONFIDENCE_THRESHOLD=0.65
# SCIENCE_GRAPHRAG_AGENT_TURN_POLICY_CLASSIFIER_TIMEOUT_SECONDS=25
# CH4 session memory: process-local (memory) or shared Redis (redis; survives API worker restarts)
# SCIENCE_GRAPHRAG_AGENT_SESSION_MEMORY_BACKEND=memory
# SCIENCE_GRAPHRAG_AGENT_SESSION_REDIS_KEY_PREFIX=science_graphrag:agent_session:v1
# SCIENCE_GRAPHRAG_AGENT_SESSION_REDIS_TTL_SECONDS=604800
# Phase 5 — optional distributed LLM quota across API workers (uses SCIENCE_GRAPHRAG_REDIS_URL)
# SCIENCE_GRAPHRAG_LLM_DISTRIBUTED_QUOTA_ENABLED=false
# SCIENCE_GRAPHRAG_LLM_DISTRIBUTED_QUOTA_KEY_PREFIX=science_graphrag:llm_quota:v1
# SCIENCE_GRAPHRAG_LLM_DISTRIBUTED_QUOTA_ACQUIRE_TIMEOUT_SECONDS=60
# SCIENCE_GRAPHRAG_LLM_DISTRIBUTED_QUOTA_LEASE_SECONDS=420
# CH5 compaction thresholds (digest cap matches in-store window of 10)
# SCIENCE_GRAPHRAG_AGENT_COMPACTION_ROLLING_MEMORY_MIN_DIGESTS=3
# SCIENCE_GRAPHRAG_AGENT_COMPACTION_DIGEST_CAP=10
#
# --- Agent rollout knobs (R0 reconciliation, 2026-05-13) ---
# Canonical matrix: docs/analysis/agent-engine-feature-status-2026-05-13.md
# Settings defaults may be True while operator policy still requires paired/live compares
# before trusting latency or cache metrics in production (E1/E2).
# SCIENCE_GRAPHRAG_AGENT_CORPUS_EXPLORE_ENABLED=true
# SCIENCE_GRAPHRAG_AGENT_RESEARCH_PLAN_SUBAGENT_ENABLED=true
# SCIENCE_GRAPHRAG_AGENT_E1_RETRIEVAL_HOP_EVIDENCE_GATE_ENABLED=true
# SCIENCE_GRAPHRAG_AGENT_TOOL_USE_SUMMARY_ENABLED=true
# SCIENCE_GRAPHRAG_AGENT_SIDE_LLM_OPENROUTER_CACHE_CONTROL_ENABLED=true
# SCIENCE_GRAPHRAG_AGENT_LLM_FULL_HISTORY_COMPACT_ENABLED=true
# Microcompact only runs when tool-history compact is enabled (see SCIENCE_GRAPHRAG_AGENT_TOOL_HISTORY_COMPACT_* above).
# SCIENCE_GRAPHRAG_AGENT_TOOL_MESSAGE_MICROCOMPACT_TIME_TRIGGER_ENABLED=true
# SCIENCE_GRAPHRAG_AGENT_THREAD_INSIGHTS_ENABLED=false
# SCIENCE_GRAPHRAG_AGENT_NOTE_ENABLED=false

# MCP surface (optional; live E2E uses docker-compose.mcp-live-check.yml overlay)
# SCIENCE_GRAPHRAG_AGENT_MCP_TOOLS_ENABLED=true
# Host stub: scripts/live_check/mcp_jsonrpc_stub.py --port 19999
# SCIENCE_GRAPHRAG_AGENT_MCP_HTTP_BASE_URL=http://host.docker.internal:19999/rpc

# Optional: require X-Admin-Key header for /v1/benchmark/* and /v1/settings/* (shared secret).
# SCIENCE_GRAPHRAG_ADMIN_API_KEY=

# --- Vite UI (`ui/`) — use `ui/.env.local` (not loaded by pydantic) ---
# VITE_API_BASE_URL=http://127.0.0.1:8787
# Wave O: collapsible Claims panel in workspace Reader tab (ReaderClaimsPanel).
# VITE_CLAIMS_UI_ENABLED=1
# Optional: default-on server sync for Ask (otherwise toggle persists in localStorage).
# VITE_SYNC_ASK_SESSIONS=true
